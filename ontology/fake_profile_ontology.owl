<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.semanticweb.org/ontologies/fake_profile_ontology#"
     xml:base="http://www.semanticweb.org/ontologies/fake_profile_ontology"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:fpo="http://www.semanticweb.org/ontologies/fake_profile_ontology#">
    
    <owl:Ontology rdf:about="http://www.semanticweb.org/ontologies/fake_profile_ontology">
        <rdfs:comment>Ontology for Cyber-Security and Social Media Fake Profile Identification and Semantic Risk Reasoning.</rdfs:comment>
        <rdfs:label>Fake Profile Detection Ontology</rdfs:label>
        <owl:versionInfo>2.0</owl:versionInfo>
    </owl:Ontology>

    <!-- //////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ////////////////////////////////////////////////////////////////////////////////////// -->

    <!-- Base Profile Class -->
    <owl:Class rdf:about="#SocialMediaProfile">
        <rdfs:label>Social Media Profile</rdfs:label>
        <rdfs:comment>The overarching entity representing a registered social media user account.</rdfs:comment>
    </owl:Class>

    <!-- Authentic Profile Hierarchy -->
    <owl:Class rdf:about="#AuthenticProfile">
        <rdfs:subClassOf rdf:resource="#SocialMediaProfile"/>
        <rdfs:label>Authentic Profile</rdfs:label>
        <rdfs:comment>Profile exhibiting standard organic human behavior, balanced networks, and content engagement.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#VerifiedAuthorityProfile">
        <rdfs:subClassOf rdf:resource="#AuthenticProfile"/>
        <rdfs:label>Verified Authority Profile</rdfs:label>
        <rdfs:comment>Authentic account with identity verification badge, substantial legitimate following and organic engagement.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#RegularOrganicUser">
        <rdfs:subClassOf rdf:resource="#AuthenticProfile"/>
        <rdfs:label>Regular Organic User</rdfs:label>
        <rdfs:comment>Ordinary person account with balanced follower/following ratios and authentic periodic posting.</rdfs:comment>
    </owl:Class>

    <!-- Suspicious Profile Hierarchy -->
    <owl:Class rdf:about="#SuspiciousProfile">
        <rdfs:subClassOf rdf:resource="#SocialMediaProfile"/>
        <rdfs:label>Suspicious Profile</rdfs:label>
        <rdfs:comment>Account showing anomalous structural or behavioral indicators warranting risk mitigation.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#FakeProfile">
        <rdfs:subClassOf rdf:resource="#SuspiciousProfile"/>
        <rdfs:label>Fake Profile</rdfs:label>
        <rdfs:comment>Confirmed fraudulent, artificially generated, or deceptive social media account.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#BotSpammerProfile">
        <rdfs:subClassOf rdf:resource="#FakeProfile"/>
        <rdfs:label>Bot Spammer Profile</rdfs:label>
        <rdfs:comment>Automated script account engaged in mass follow/unfollow tactics, spam distribution, or phishing.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#GhostLurkerProfile">
        <rdfs:subClassOf rdf:resource="#FakeProfile"/>
        <rdfs:label>Ghost Lurker Profile</rdfs:label>
        <rdfs:comment>Empty account created for mass stalking, surveillance, or dormant puppet network amplification.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#EngagementAnomalyProfile">
        <rdfs:subClassOf rdf:resource="#FakeProfile"/>
        <rdfs:label>Engagement Anomaly Profile</rdfs:label>
        <rdfs:comment>Account displaying purchased/fabricated followers with disproportionately negligible engagement.</rdfs:comment>
    </owl:Class>

    <!-- Risk Level Classes -->
    <owl:Class rdf:about="#RiskCategory">
        <rdfs:label>Risk Category</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="#LowRisk">
        <rdfs:subClassOf rdf:resource="#RiskCategory"/>
        <rdfs:label>Low Risk</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="#MediumRisk">
        <rdfs:subClassOf rdf:resource="#RiskCategory"/>
        <rdfs:label>Medium Risk</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="#HighRisk">
        <rdfs:subClassOf rdf:resource="#RiskCategory"/>
        <rdfs:label>High Risk</rdfs:label>
    </owl:Class>

    <!-- Detection Rules and Indicators -->
    <owl:Class rdf:about="#DetectionRule">
        <rdfs:label>Detection Rule</rdfs:label>
    </owl:Class>

    <!-- //////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ////////////////////////////////////////////////////////////////////////////////////// -->

    <owl:ObjectProperty rdf:about="#hasRiskCategory">
        <rdfs:domain rdf:resource="#SocialMediaProfile"/>
        <rdfs:range rdf:resource="#RiskCategory"/>
        <rdfs:label>has risk category</rdfs:label>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#violatesRule">
        <rdfs:domain rdf:resource="#SocialMediaProfile"/>
        <rdfs:range rdf:resource="#DetectionRule"/>
        <rdfs:label>violates rule</rdfs:label>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#exhibitsAnomaly">
        <rdfs:domain rdf:resource="#SocialMediaProfile"/>
        <rdfs:label>exhibits anomaly</rdfs:label>
    </owl:ObjectProperty>

    <!-- //////////////////////////////////////////////////////////////////////////////////////
    //
    // Data Properties
    //
    ////////////////////////////////////////////////////////////////////////////////////// -->

    <owl:DatatypeProperty rdf:about="#hasUsername">
        <rdfs:domain rdf:resource="#SocialMediaProfile"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>has username</rdfs:label>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#hasFollowersCount">
        <rdfs:domain rdf:resource="#SocialMediaProfile"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:label>has followers count</rdfs:label>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#hasFollowingCount">
        <rdfs:domain rdf:resource="#SocialMediaProfile"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:label>has following count</rdfs:label>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#hasPostsCount">
        <rdfs:domain rdf:resource="#SocialMediaProfile"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:label>has posts count</rdfs:label>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#hasAccountAgeDays">
        <rdfs:domain rdf:resource="#SocialMediaProfile"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:label>has account age days</rdfs:label>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#hasBioLength">
        <rdfs:domain rdf:resource="#SocialMediaProfile"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:label>has bio length</rdfs:label>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#hasProfilePicture">
        <rdfs:domain rdf:resource="#SocialMediaProfile"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:label>has profile picture</rdfs:label>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#isVerified">
        <rdfs:domain rdf:resource="#SocialMediaProfile"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:label>is verified</rdfs:label>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#hasFollowerRatio">
        <rdfs:domain rdf:resource="#SocialMediaProfile"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:label>has follower ratio</rdfs:label>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#hasEngagementRate">
        <rdfs:domain rdf:resource="#SocialMediaProfile"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:label>has engagement rate</rdfs:label>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#hasSuspicionScore">
        <rdfs:domain rdf:resource="#SocialMediaProfile"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:label>has suspicion score</rdfs:label>
    </owl:DatatypeProperty>

    <!-- //////////////////////////////////////////////////////////////////////////////////////
    //
    // Rule Individuals
    //
    ////////////////////////////////////////////////////////////////////////////////////// -->

    <owl:NamedIndividual rdf:about="#Rule_FollowerAsymmetry">
        <rdf:type rdf:resource="#DetectionRule"/>
        <rdfs:label>Rule: Following-to-Follower Asymmetry (Ratio &lt; 0.05)</rdfs:label>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="#Rule_GhostLurker">
        <rdf:type rdf:resource="#DetectionRule"/>
        <rdfs:label>Rule: Dormant Ghost Profile (Age &gt; 180 days, Posts = 0, Following &gt; 100)</rdfs:label>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="#Rule_HyperactiveNewAccount">
        <rdf:type rdf:resource="#DetectionRule"/>
        <rdfs:label>Rule: Hyperactive New Account (Age &lt; 14 days, Following &gt; 500)</rdfs:label>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="#Rule_NoAvatarEmptyBio">
        <rdf:type rdf:resource="#DetectionRule"/>
        <rdfs:label>Rule: Anonymous Profile (No Avatar, Bio = 0, Posts &lt;= 2)</rdfs:label>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="#Rule_EngagementAnomaly">
        <rdf:type rdf:resource="#DetectionRule"/>
        <rdfs:label>Rule: Inflated Following Anomaly (Followers &gt; 10,000, Engagement &lt; 0.01%)</rdfs:label>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="#Rule_MachineGeneratedHandle">
        <rdf:type rdf:resource="#DetectionRule"/>
        <rdfs:label>Rule: Bot Name Pattern (&gt; 40% numeric digits in handle)</rdfs:label>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="#Rule_AuthenticityMitigation">
        <rdf:type rdf:resource="#DetectionRule"/>
        <rdfs:label>Rule: Verified Entity Exemption</rdfs:label>
    </owl:NamedIndividual>

    <!-- //////////////////////////////////////////////////////////////////////////////////////
    //
    // Benchmark Profile Individuals (Protégé Compatible)
    //
    ////////////////////////////////////////////////////////////////////////////////////// -->

    <owl:NamedIndividual rdf:about="#Individual_Elena_AI">
        <rdf:type rdf:resource="#VerifiedAuthorityProfile"/>
        <hasUsername rdf:datatype="http://www.w3.org/2001/XMLSchema#string">dr_elena_ai_official</hasUsername>
        <hasFollowersCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">94500</hasFollowersCount>
        <hasFollowingCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">820</hasFollowingCount>
        <hasPostsCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1280</hasPostsCount>
        <hasAccountAgeDays rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2400</hasAccountAgeDays>
        <hasBioLength rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">140</hasBioLength>
        <hasProfilePicture rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</hasProfilePicture>
        <isVerified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</isVerified>
        <hasSuspicionScore rdf:datatype="http://www.w3.org/2001/XMLSchema#float">2.5</hasSuspicionScore>
        <hasRiskCategory rdf:resource="#LowRisk"/>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="#Individual_Spammer_9921">
        <rdf:type rdf:resource="#BotSpammerProfile"/>
        <hasUsername rdf:datatype="http://www.w3.org/2001/XMLSchema#string">bot_spammer_9921</hasUsername>
        <hasFollowersCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">12</hasFollowersCount>
        <hasFollowingCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2850</hasFollowingCount>
        <hasPostsCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</hasPostsCount>
        <hasAccountAgeDays rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">7</hasAccountAgeDays>
        <hasBioLength rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</hasBioLength>
        <hasProfilePicture rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</hasProfilePicture>
        <isVerified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</isVerified>
        <hasSuspicionScore rdf:datatype="http://www.w3.org/2001/XMLSchema#float">96.0</hasSuspicionScore>
        <violatesRule rdf:resource="#Rule_FollowerAsymmetry"/>
        <violatesRule rdf:resource="#Rule_HyperactiveNewAccount"/>
        <violatesRule rdf:resource="#Rule_NoAvatarEmptyBio"/>
        <hasRiskCategory rdf:resource="#HighRisk"/>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="#Individual_Organic_Sarah">
        <rdf:type rdf:resource="#RegularOrganicUser"/>
        <hasUsername rdf:datatype="http://www.w3.org/2001/XMLSchema#string">cyber_tech_sarah</hasUsername>
        <hasFollowersCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4820</hasFollowersCount>
        <hasFollowingCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">620</hasFollowingCount>
        <hasPostsCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">345</hasPostsCount>
        <hasAccountAgeDays rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1240</hasAccountAgeDays>
        <hasBioLength rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">115</hasBioLength>
        <hasProfilePicture rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</hasProfilePicture>
        <isVerified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</isVerified>
        <hasSuspicionScore rdf:datatype="http://www.w3.org/2001/XMLSchema#float">8.0</hasSuspicionScore>
        <hasRiskCategory rdf:resource="#LowRisk"/>
    </owl:NamedIndividual>

</rdf:RDF>
